# Brevo — correo transaccional para los leads del formulario.
# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.

# Clave de API v3 de Brevo. Se genera en Brevo > SMTP & API > API Keys.
# Es un secreto: no la pegues aquí, va en .env.local.
BREVO_API_KEY=

# Remitente verificado en Brevo. El dominio debe estar autenticado (DKIM/DMARC).
BREVO_SENDER_EMAIL=

# Buzón que recibe los leads del formulario.
LEADS_TO_EMAIL=
